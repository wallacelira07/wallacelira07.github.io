# whatsapp-agent/.env.example
# Copie para ".env" (NUNCA commitar o .env real) e preencha os valores reais.
# Nenhum segredo deve viver neste arquivo de exemplo.

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=3000

# ---------------------------------------------------------------------------
# Anthropic (Claude) — modelo que interpreta a mensagem e decide o que fazer
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5 é o modelo atual recomendado (console.anthropic.com/settings/models
# tem a lista completa). Troque por um mais barato (ex: claude-sonnet-5/haiku) se
# o custo por mensagem do WhatsApp importar mais que a qualidade da resposta —
# isso é decisão sua, o código não força nada.
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Supabase — MESMO projeto V2 relacional que alimenta o site (bakdgacmwlopvrrppwdm)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://bakdgacmwlopvrrppwdm.supabase.co
# Use a service_role key (mesma classe de chave que os scripts em scripts/sync/*.py
# já usam) — o agente precisa ler vw_saldo_v2_por_caixa/transacoes/caixas/cartoes/
# usuarios/categorias e chamar a RPC lancar_transacao_manual. NUNCA exponha essa
# chave fora do servidor (nunca no client WhatsApp, nunca em log).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Canal WhatsApp — escolha UM provider. Ver README.md para trade-offs.
# ---------------------------------------------------------------------------
# "twilio" (recomendado para prototipar — Sandbox sem aprovação da Meta) ou
# "meta" (WhatsApp Business Cloud API oficial — necessário para produção real).
WHATSAPP_PROVIDER=twilio

# --- Twilio WhatsApp Sandbox / número aprovado ------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número Twilio no formato "whatsapp:+14155238886" (Sandbox) ou o número real
# comprado/aprovado.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Meta WhatsApp Business Cloud API (produção) ----------------------------
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
# Token que você mesmo inventa e cadastra no painel da Meta ao configurar o
# webhook (GET de verificação) — qualquer string secreta serve.
WHATSAPP_META_VERIFY_TOKEN=
# App Secret do App da Meta — usado para validar a assinatura X-Hub-Signature-256
# de cada POST recebido (nunca aceitar payload sem essa validação em produção).
WHATSAPP_META_APP_SECRET=

# ---------------------------------------------------------------------------
# Segurança da aplicação
# ---------------------------------------------------------------------------
# Lista de números autorizados a falar com o agente, separados por vírgula, no
# formato E.164 (ex: +5541999999999). Este bot lê saldo/lança transação real —
# NUNCA rode em produção sem essa allowlist. Deixe vazio só em teste local com
# dados fake.
WALLACE_WHATSAPP_ALLOWED_NUMBERS=+5541999999999

# Minutos que uma proposta de lançamento fica "esperando confirmação" antes de
# expirar automaticamente (o usuário precisa responder "sim"/"confirmo" dentro
# desse prazo, senão tem que pedir de novo).
CONFIRMATION_TIMEOUT_MINUTES=15
