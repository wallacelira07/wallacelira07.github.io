# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env real (o .gitignore deste diretório já bloqueia isso).

# Token do bot, obtido do @BotFather no Telegram (ver PROXIMOS_PASSOS.md passo 1).
TELEGRAM_BOT_TOKEN=

# Timeout do long-polling em segundos — não precisa mexer, 30 é o recomendado
# pela própria documentação do Telegram.
TELEGRAM_POLLING_TIMEOUT_SEGUNDOS=30

# Chave da API da Anthropic (console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Mesmo projeto Supabase do site (bakdgacmwlopvrrppwdm). SUPABASE_SERVICE_ROLE_KEY
# é a chave de escrita (Project Settings -> API -> "service_role") — NUNCA a
# chave pública/anon. Dá acesso total ao banco, trate como senha.
SUPABASE_URL=https://bakdgacmwlopvrrppwdm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Lista de chat_id do Telegram autorizados a conversar com o bot, separados
# por vírgula (ex: 123456789,987654321). Vazio = ninguém autorizado (falha
# segura). Ver PROXIMOS_PASSOS.md passo 2 pra descobrir o seu.
ALLOWED_TELEGRAM_CHAT_IDS=

# Minutos que uma proposta de lançamento fica esperando confirmação antes de
# expirar sozinha.
CONFIRMATION_TIMEOUT_MINUTES=15
